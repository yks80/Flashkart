{
  "name": "flashkart",
  "version": "1.0.0",
  "description": "High-concurrency flash sale platform (Node/Express/TypeScript/TypeORM/PostgreSQL/Redis)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc && npm run copy:lua",
    "copy:lua": "mkdir -p dist/redis/lua && cp src/redis/lua/*.lua dist/redis/lua/",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/config/dataSource.ts src/migrations/Migration",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/config/dataSource.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/config/dataSource.ts",
    "seed": "ts-node scripts/seed.ts",
    "loadtest": "ts-node scripts/loadTest.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ioredis": "^5.4.1",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3"
  }
}
