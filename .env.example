# App
PORT=3000
NODE_ENV=development

# Postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=flashkart
DB_PASSWORD=flashkart
DB_NAME=flashkart
# Set to true ONLY in dev to auto-create tables without migrations
DB_SYNCHRONIZE=true

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Reservation window in milliseconds (5 minutes)
RESERVATION_TTL_MS=300000
# Reaper poll interval in milliseconds
REAPER_INTERVAL_MS=2000
